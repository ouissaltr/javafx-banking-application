<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.AccountviewController"
      spacing="15" alignment="CENTER" style="-fx-padding: 20;">

    <Label fx:id="accountLabel" style="-fx-font-size: 20px;"/>
    <Label fx:id="balanceLabel" style="-fx-font-size: 16px;"/>

    <ListView fx:id="transactionListView" prefWidth="400" prefHeight="300"/>

    <HBox spacing="10">
        <Button text="Neue Transaktion" onAction="#newTransaction"/>
        <Button text="Transaktion löschen" onAction="#deleteTransaction"/>
        <Button text="Zurück" onAction="#goBack"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Sort ↑" onAction="#sortAsc"/>
        <Button text="Sort ↓" onAction="#sortDesc"/>
        <Button text="Nur positiv" onAction="#filterPositive"/>
        <Button text="Nur negativ" onAction="#filterNegative"/>
        <Button text="Alle" onAction="#showAll"/>
    </HBox>


</VBox>
